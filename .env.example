# ==========================================
# Card Games By Madhav - Environment Setup
# ==========================================

# 1. MongoDB Connection String (from MongoDB Atlas)
# Replace with your actual username, password, and database name
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cardgames?retryWrites=true&w=majority

# 2. Server Port (defaults to 3000 locally, 10000 on Render)
PORT=3000

# 3. WebSocket URL (used by Vercel frontend to reach Render backend)
# Example: NEXT_PUBLIC_SOCKET_URL=https://your-render-app.onrender.com
NEXT_PUBLIC_SOCKET_URL=
